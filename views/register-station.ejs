   <!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jula - Inscription Point Relais</title>
    <!-- Icônes Modernes Google Material Sécurisées -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <style>
        :root { 
            --jula-orange: #f57c00; 
            --station-green: #2e7d32; 
            --dark-bg: #111417; 
            --card-bg: #1a1d21;
            --border-color: #2d3139;
            --jula-blue: #1072ba;
        }
        body { font-family: 'Segoe UI', system-ui, sans-serif; background-color: var(--dark-bg); margin: 0; padding: 20px; color: #ecf0f1; }
        .form-container { max-width: 500px; background: var(--card-bg); margin: 30px auto; padding: 40px 30px; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); border: 1px solid var(--border-color); border-top: 5px solid var(--station-green); position: relative; }
        .btn-back { position: absolute; top: 20px; left: 20px; color: #7f8c8d; text-decoration: none; display: flex; align-items: center; gap: 4px; font-size: 13px; font-weight: 600; transition: color 0.2s; }
        .btn-back:hover { color: var(--station-green); }
        h2 { text-align: center; color: #fff; margin-bottom: 8px; font-weight: 800; font-size: 24px; margin-top: 15px; }
        .subtitle { text-align: center; font-size: 13px; color: #7f8c8d; margin-bottom: 25px; line-height: 18px; }
        .form-group { margin-bottom: 20px; text-align: left; }
        label { display: block; font-weight: 600; margin-bottom: 8px; font-size: 13.5px; letter-spacing: 0.3px; color: #ecf0f1; }
        input, select { width: 100%; padding: 12px 14px; background-color: var(--dark-bg); border: 1px solid var(--border-color); border-radius: 6px; box-sizing: border-box; font-size: 14.5px; color: #fff; outline: none; transition: border-color 0.2s; }
        input:focus, select:focus { border-color: var(--station-green); }
        
        /* 📸 STYLE DE LA ZONE DE CAPTURE PHOTO INTERACTIVE AVEC APERÇU ET REMPLACEMENT */
        .zone-apercu-photo { display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.02); border: 2px dashed var(--border-color); border-radius: 8px; padding: 15px; text-align: center; position: relative; cursor: pointer; transition: 0.2s; }
        .zone-apercu-photo:hover { border-color: var(--station-green); background: rgba(46, 125, 50, 0.02); }
        .zone-apercu-photo span.icone-cam { font-size: 32px; color: #7f8c8d; margin-bottom: 5px; }
        .zone-apercu-photo p { margin: 0; font-size: 12px; color: #7f8c8d; }
        .image-rendu { width: 100%; height: 140px; object-fit: cover; border-radius: 6px; display: none; margin-top: 10px; border: 1px solid var(--border-color); }
        .btn-modifier-photo { display: none; margin-top: 8px; background: rgba(16, 114, 186, 0.2); color: #29b6f6; border: 1px solid rgba(16, 114, 186, 0.3); padding: 6px 12px; border-radius: 4px; font-size: 11.5px; font-weight: bold; cursor: pointer; }
        
        .btn-submit { width: 100%; background: linear-gradient(135deg, var(--station-green), #1b5e20); color: white; padding: 14px; border: none; border-radius: 6px; font-size: 15px; font-weight: bold; cursor: pointer; box-shadow: 0 4px 12px rgba(46,125,50,0.2); transition: all 0.2s; margin-top: 15px; }
        .btn-submit:hover { opacity: 0.95; }
    </style>
</head>
<body>

              <!-- Bouton retour universel en français Jula -->
        <a href="/" class="btn-back">
            ← Accueil
        </a>

        <h2>Devenir Point Relais Jula</h2>
        <p class="subtitle">Rentabilisez votre espace de stockage, sécurisez les colis transfrontaliers et contrôlez vos fichiers en direct</p>
        
        <form action="/submit-partner" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="business_type" value="relais">
            
            <div class="form-group">
                <label>Nom complet du gérant</label>
                <input type="text" name="full_name" placeholder="Ex: Amadou Diallo" required>
            </div>
            <div class="form-group">
                <label>Nom de l'Espace / Point d'Accueil</label>
                <input type="text" name="shop_name" placeholder="Ex: Boutique Diallo Telecom" required>
            </div>

            <div class="form-group">
                <label>Numéro de Téléphone (Mobile Money actif)</label>
                <input type="tel" name="phone" placeholder="Ex: +225 0101..." required>
            </div>

            <div class="form-group">
                <label>Adresse Électronique (Email)</label>
                <input type="email" name="email" placeholder="Ex: diallo@jula-relais.com" required autocomplete="email">
            </div>

                          <div class="form-group">
    <label>Mot de passe d'accès</label>
    <div style="position: relative; display: flex; align-items: center;">
        <input type="password" id="champMotDePasse" name="password" placeholder="Minimum 6 caractères" style="padding-right: 45px;" required>
        <button type="button" onclick="basculerOeilInscription()" style="position: absolute; right: 10px; background: none; border: none; color: #7f8c8d; cursor: pointer; outline: none; padding: 0;">
            <span class="material-icons-round" id="iconeOeil" style="font-size: 22px; vertical-align: middle;">visibility_off</span>
        </button>
    </div>
</div>



            <div class="form-group">
                <label>Pays de localisation</label>
                <select name="country" required>
                    <option value="CI">🇨🇮 Côte d'Ivoire</option>
                    <option value="SN">🇸🇳 Sénégal</option>
                    <option value="ML">🇲🇱 Mali</option>
                    <option value="BF">🇧🇫 Burkina Faso</option>
                    <option value="TG">🇹🇬 Togo</option>
                    <option value="BJ">🇧🇯 Bénin</option>
                    <option value="NE">🇳🇪 Niger</option>
                </select>
            </div>
            
            <!-- 📸 CNI RECTO INTERACTIF -->
            <div class="form-group" style="text-align: center;">
                <label style="text-align: left;">📄 Pièce d'identité nationale (RECTO)</label>
                <div class="zone-apercu-photo" onclick="declencherApercuPhoto('fichCniRecto')">
                    <span class="material-icons-round icone-cam" id="ic-fichCniRecto"></span>
                    <p id="txt-fichCniRecto">Cliquez pour prendre le RECTO ou ouvrir la galerie</p>
                    <img id="img-fichCniRecto" class="image-rendu" alt="Aperçu Recto">
                    <input type="file" id="fichCniRecto" name="cni_recto" accept="image/*" style="display: none;" onchange="gererChangementPhoto(event, 'fichCniRecto')" required>
                </div>
                <button type="button" class="btn-modifier-photo" id="btn-fichCniRecto" onclick="declencherApercuPhoto('fichCniRecto')">📝 Remplacer / Modifier la photo</button>
            </div>

            <!-- 📸 CNI VERSO INTERACTIF -->
            <div class="form-group" style="text-align: center;">
                <label style="text-align: left;">📄 Pièce d'identité nationale (VERSO)</label>
                <div class="zone-apercu-photo" onclick="declencherApercuPhoto('fichCniVerso')">
                    <span class="material-icons-round icone-cam" id="ic-fichCniVerso"></span>
                    <p id="txt-fichCniVerso">Cliquez pour prendre le VERSO ou ouvrir la galerie</p>
                    <img id="img-fichCniVerso" class="image-rendu" alt="Aperçu Verso">
                    <input type="file" id="fichCniVerso" name="cni_verso" accept="image/*" style="display: none;" onchange="gererChangementPhoto(event, 'fichCniVerso')" required>
                </div>
                <button type="button" class="btn-modifier-photo" id="btn-fichCniVerso" onclick="declencherApercuPhoto('fichCniVerso')">📝 Remplacer / Modifier la photo</button>
            </div>

            <!-- 📸 PHOTO DE LA BOUTIQUE / LOCAL DE STOCKAGE INTERACTIVE -->
            <div class="form-group" style="text-align: center;">
                <label style="text-align: left;"> Photo du Local de Stockage</label>
                <div class="zone-apercu-photo" onclick="declencherApercuPhoto('fichBoutique')">
                    <span class="material-icons-round icone-cam" id="ic-fichBoutique"></span>
                    <p id="txt-fichBoutique">Prenez une photo claire de votre local ou espace physique</p>
                    <img id="img-fichBoutique" class="image-rendu" alt="Aperçu Espace">
                    <input type="file" id="fichBoutique" name="photo_boutique" accept="image/*" style="display: none;" onchange="gererChangementPhoto(event, 'fichBoutique')" required>
                </div>
                <button type="button" class="btn-modifier-photo" id="btn-fichBoutique" onclick="declencherApercuPhoto('fichBoutique')">📝 Remplacer / Modifier la photo</button>
            </div>

            <div style="display: flex; gap: 12px; margin-top: 25px;">
                <a href="/" class="btn-submit" style="background: #c62828; text-decoration: none; text-align: center; width: 35%; display: flex; align-items: center; justify-content: center; gap: 4px;">
                    <span class="material-icons-round" style="font-size: 16px;"></span> Quitter
                </a>
                <button type="submit" class="btn-submit" style="width: 65%;">Valider mon inscription Point Relais Jula</button>
            </div>
        </form>
    </div>

    <!-- ⚙️ LE MOTEUR JAVASCRIPT REVOIR / MODIFIER LES PHOTOS ET MOT DE PASSE -->
    <script>
    function basculerOeilInscription() {
        const champ = document.getElementById('champMotDePasse');
        const icone = document.getElementById('iconeOeil');
        if (champ.type === 'password') {
            champ.type = 'text';
            icone.innerText = 'visibility';
            icone.style.color = 'var(--jula-orange)';
        } else {
            champ.type = 'password';
            icone.innerText = 'visibility_off';
            icone.style.color = '#7f8c8d';
        }
    }




        // 2. DECLENCHEUR DU CLIC SUR LE MOBILE DE CAPTURE PHOTO
        function declencherApercuPhoto(inputId) {
            document.getElementById(inputId).click();
        }

        // 3. AFFICHAGE ET MODIFICATION EN DIRECT SI LE GÉRANT SE TROMPE
        function gererChangementPhoto(evenement, inputId) {
            const elementsFichiers = evenement.target.files;
            
            if (elementsFichiers && elementsFichiers.length > 0) {
                const lecteur = new FileReader();
                
                lecteur.onload = function(e) {
                    // Masquer l'icône et le texte par défaut
                    document.getElementById('ic-' + inputId).style.display = 'none';
                    document.getElementById('txt-' + inputId).style.display = 'none';
                    
                    // Rendre l'image visible et injecter la photo prise
                    const baliseImg = document.getElementById('img-' + inputId);
                    baliseImg.src = e.target.result;
                    baliseImg.style.display = 'block';
                    
                    // Allumer le bouton de modification si on s'est trompé
                    document.getElementById('btn-' + inputId).style.display = 'inline-block';
                };
                
                lecteur.readAsDataURL(elementsFichiers);
            }
        }
    </script>
</body>
</html>
