    <!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jula - Inscription Livreur Coursier</title>
    <!-- Icônes Modernes Google Material Sécurisées -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <style>
        :root { 
            --jula-orange: #f57c00; 
            --jula-blue: #1072ba; 
            --dark-bg: #111417; 
            --card-bg: #1a1d21;
            --border-color: #2d3139;
            --jula-vert: #2e7d32;
        }
        body { font-family: 'Segoe UI', system-ui, sans-serif; background-color: var(--dark-bg); margin: 0; padding: 20px; color: #ecf0f1; }
        .form-container { max-width: 500px; background: var(--card-bg); margin: 30px auto; padding: 40px 30px; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); border: 1px solid var(--border-color); border-top: 5px solid var(--jula-blue); position: relative; }
        .btn-back { position: absolute; top: 20px; left: 20px; color: #7f8c8d; text-decoration: none; display: flex; align-items: center; gap: 4px; font-size: 13px; font-weight: 600; transition: color 0.2s; }
        .btn-back:hover { color: var(--jula-blue); }
        h2 { text-align: center; color: #fff; margin-bottom: 8px; font-weight: 800; font-size: 24px; margin-top: 15px; }
        .subtitle { text-align: center; font-size: 13px; color: #7f8c8d; margin-bottom: 25px; line-height: 18px; }
        .form-group { margin-bottom: 20px; text-align: left; }
        label { display: block; font-weight: 600; margin-bottom: 8px; font-size: 13.5px; letter-spacing: 0.3px; color: #ecf0f1; }
        input, select { width: 100%; padding: 12px 14px; background-color: var(--dark-bg); border: 1px solid var(--border-color); border-radius: 6px; box-sizing: border-box; font-size: 14.5px; color: #fff; outline: none; transition: border-color 0.2s; }
        input:focus, select:focus { border-color: var(--jula-blue); }
        
         /* 📸 STYLE DE LA ZONE DE CAPTURE PHOTO INTERACTIVE AVEC APERÇU ET REMPLACEMENT */
        .zone-apercu-photo { display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.02); border: 2px dashed var(--border-color); border-radius: 8px; padding: 15px; text-align: center; position: relative; cursor: pointer; transition: 0.2s; }
        .zone-apercu-photo:hover { border-color: var(--jula-blue); background: rgba(16, 114, 186, 0.02); }
        .zone-apercu-photo span.icone-cam { font-size: 32px; color: #7f8c8d; margin-bottom: 5px; }
        .zone-apercu-photo p { margin: 0; font-size: 12px; color: #7f8c8d; }
        .image-rendu { width: 100%; height: 140px; object-fit: cover; border-radius: 6px; display: none; margin-top: 10px; border: 1px solid var(--border-color); }
        .btn-modifier-photo { display: none; margin-top: 8px; background: rgba(16, 114, 186, 0.2); color: #29b6f6; border: 1px solid rgba(16, 114, 186, 0.3); padding: 6px 12px; border-radius: 4px; font-size: 11.5px; font-weight: bold; cursor: pointer; }
        
        /* ❌ LA CROIX ROUGE DE SUPPRESSION AJOUTÉE AU PIXEL PRÈS */
        .croix-supprimer {
            position: absolute;
            top: 8px;
            right: 8px;
            background-color: #e53935;
            color: white;
            border: none;
            border-radius: 50%;
            width: 26px;
            height: 26px;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            display: none; /* Masqué tant qu'il n'y a pas de photo */
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.3);
            z-index: 5;
            outline: none;
        }
        .croix-supprimer:hover { background-color: #b71c1c; }

        .btn-submit { width: 100%; background: linear-gradient(135deg, var(--jula-blue), #0d5c97); color: white; padding: 14px; border: none; border-radius: 6px; font-size: 15px; font-weight: bold; cursor: pointer; box-shadow: 0 4px 12px rgba(16,114,186,0.2); transition: all 0.2s; margin-top: 15px; }
        .btn-submit:hover { opacity: 0.95; }
    </style>
</head>
<body>


             <!-- Bouton retour universel en français Jula -->
        <a href="/" class="btn-back">
            ← Accueil
        </a>


        <h2> Devenir Livreur Jula</h2>
        <p class="subtitle">Rejoignez la flotte Jula Network, contrôlez vos justificatifs et maximisez vos gains logistiques en zone CFA</p>
        
        <form action="/submit-partner" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="business_type" value="livreur">
            
            <div class="form-group">
                <label>Nom complet du coursier</label>
                <input type="text" name="full_name" placeholder="Ex: Sékou Touré" required>
            </div>
            <div class="form-group">
                <label>Numéro de Plaque d'Immatriculation</label>
                <input type="text" name="vehicle_plate" placeholder="Ex: 4567-IU-01" required>
            </div>

            <div class="form-group">
                <label>Numéro de Téléphone (Orange, Wave, MTN...)</label>
                <input type="tel" name="phone" placeholder="Ex: +225 0505..." required>
            </div>

            <div class="form-group">
                <label>Adresse Électronique (Email)</label>
                <input type="email" name="email" placeholder="Ex: sekou@jula-livraison.com" required autocomplete="email">
            </div>

                       <div class="form-group">
    <label>Mot de passe d'accès</label>
    <div style="position: relative; display: flex; align-items: center;">
        <input type="password" id="champMotDePasse" name="password" placeholder="Minimum 6 caractères" style="padding-right: 45px;" required>
        <button type="button" onclick="basculerOeilInscription()" style="position: absolute; right: 10px; background: none; border: none; color: #7f8c8d; cursor: pointer; outline: none; padding: 0;">
            <span class="material-icons-round" id="iconeOeil" style="font-size: 22px; vertical-align: middle;">visibility_off</span>
        </button>
    </div>
</div>



            <div class="form-group">
                <label>Zone de livraison principale</label>
                <select name="country" required>
                    <option value="CI">🇨🇮 Côte d'Ivoire</option>
                    <option value="SN">🇸🇳 Sénégal</option>
                    <option value="ML">🇲🇱 Mali</option>
                    <option value="BF">🇧🇫 Burkina Faso</option>
                    <option value="TG">🇹🇬 Togo</option>
                    <option value="BJ">🇧🇯 Bénin</option>
                    <option value="NE">🇳🇪 Niger</option>
                </select>
            </div>
            
                   <!-- ✨ FIXÉ : enctype ajouté pour stabiliser la RAM du Tecno Pop 9 et autoriser l'envoi d'images -->
        <form action="/submit-partner" method="POST" enctype="multipart/form-data">
            
            <!-- (Garde tes cases de texte au-dessus : Nom, Téléphone, Email, Mot de passe...) -->

            <!-- 📸 CNI RECTO INTERACTIF (100% PERSISTANT) -->
            <div class="form-group" style="text-align: center; position: relative; margin-bottom: 25px;">
                <label style="text-align: left; display: block; font-weight: 600; margin-bottom: 8px;">📄 Pièce d'identité nationale (RECTO)</label>
                <div class="zone-apercu-photo" onclick="document.getElementById('fichCniRecto').click()" style="min-height: 150px; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative;">
                    
                    <!-- ❌ La Croix Rouge de suppression en haut à droite (type="button" obligatoire) -->
                    <button type="button" class="croix-supprimer" id="croix-fichCniRecto" onclick="effacerPhotoSelectionnee(event, 'fichCniRecto')">×</button>

                    <span class="material-icons-round icone-cam" id="ic-fichCniRecto" style="font-size: 40px; color: #7f8c8d; display: inline-block;">photo_camera</span>
                    <p id="txt-fichCniRecto" style="margin: 8px 0 0 0; font-size: 13px; color: #7f8c8d;">Cliquez pour ouvrir l'appareil photo ou la galerie</p>
                    
                    <img id="img-fichCniRecto" class="image-rendu" alt="Aperçu Recto" style="width: 100%; height: 140px; object-fit: cover; display: none;">
                    <input type="file" id="fichCniRecto" name="cni_recto" accept="image/*" style="display: none;" onchange="gererChangementPhoto(event, 'fichCniRecto')" required>
                </div>
                <button type="button" class="btn-modifier-photo" id="btn-fichCniRecto" onclick="document.getElementById('fichCniRecto').click()" style="display: none;">📝 Remplacer / Modifier la photo</button>
            </div>

            <!-- 📸 CNI VERSO INTERACTIF (100% PERSISTANT) -->
            <div class="form-group" style="text-align: center; position: relative; margin-bottom: 25px;">
                <label style="text-align: left; display: block; font-weight: 600; margin-bottom: 8px;">📄 Pièce d'identité nationale (VERSO)</label>
                <div class="zone-apercu-photo" onclick="document.getElementById('fichCniVerso').click()" style="min-height: 150px; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative;">
                    
                    <!-- ❌ La Croix Rouge de suppression en haut à droite (type="button" obligatoire) -->
                    <button type="button" class="croix-supprimer" id="croix-fichCniVerso" onclick="effacerPhotoSelectionnee(event, 'fichCniVerso')">×</button>

                    <span class="material-icons-round icone-cam" id="ic-fichCniVerso" style="font-size: 40px; color: #7f8c8d; display: inline-block;">photo_camera</span>
                    <p id="txt-fichCniVerso" style="margin: 8px 0 0 0; font-size: 13px; color: #7f8c8d;">Cliquez pour ouvrir l'appareil photo ou la galerie</p>
                    
                    <img id="img-fichCniVerso" class="image-rendu" alt="Aperçu Verso" style="width: 100%; height: 140px; object-fit: cover; display: none;">
                    <input type="file" id="fichCniVerso" name="cni_verso" accept="image/*" style="display: none;" onchange="gererChangementPhoto(event, 'fichCniVerso')" required>
                </div>
                <button type="button" class="btn-modifier-photo" id="btn-fichCniVerso" onclick="document.getElementById('fichCniVerso').click()" style="display: none;">📝 Remplacer / Modifier la photo</button>
            </div>

            <!-- 📸 PHOTO DE LA MOTO / VÉHICULE INTERACTIVE (100% PERSISTANTE) -->
            <div class="form-group" style="text-align: center; position: relative; margin-bottom: 25px;">
                <label style="text-align: left; display: block; font-weight: 600; margin-bottom: 8px;">🏍️ Photo de votre Moto ou Véhicule</label>
                <div class="zone-apercu-photo" onclick="document.getElementById('fichVehicule').click()" style="min-height: 150px; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative;">
                    
                    <!-- ❌ La Croix Rouge de suppression en haut à droite (type="button" obligatoire) -->
                    <button type="button" class="croix-supprimer" id="croix-fichVehicule" onclick="effacerPhotoSelectionnee(event, 'fichVehicule')">×</button>

                    <span class="material-icons-round icone-cam" id="ic-fichVehicule" style="font-size: 40px; color: #7f8c8d; display: inline-block;">photo_camera</span>
                    <p id="txt-fichVehicule" style="margin: 8px 0 0 0; font-size: 13px; color: #7f8c8d;">Prenez une photo claire de votre engin avec plaque visible</p>
                    
                    <img id="img-fichVehicule" class="image-rendu" alt="Aperçu Véhicule" style="width: 100%; height: 140px; object-fit: cover; display: none;">
                    <input type="file" id="fichVehicule" name="photo_vehicule" accept="image/*" style="display: none;" onchange="gererChangementPhoto(event, 'fichVehicule')" required>
                </div>
                <button type="button" class="btn-modifier-photo" id="btn-fichVehicule" onclick="document.getElementById('fichVehicule').click()" style="display: none;">📝 Remplacer / Modifier la photo</button>
            </div>

           

 <div style="display: flex; gap: 12px; margin-top: 25px;">
                <a href="/" class="btn-submit" style="background: #c62828; text-decoration: none; text-align: center; width: 35%; display: flex; align-items: center; justify-content: center; gap: 4px;">
                    <span class="material-icons-round" style="font-size: 16px;"></span> Quitter
                </a>
                <button type="submit" class="btn-submit" style="width: 65%;">Finaliser mon inscription</button>
            </div>
        </form>
    </div>

         <!-- ⚙️ SCRIPT DE SECOURS ULTRA-LÉGER ANTI-EFFACEMENT -->
    <script>
        function basculerOeilInscription() {
            const champ = document.getElementById('champMotDePasse');
            const icone = document.getElementById('iconeOeil');
            if (champ.type === 'password') {
                champ.type = 'text';
                icone.innerText = 'visibility';
                icone.style.color = 'var(--jula-orange)';
            } else {
                champ.type = 'password';
                icone.innerText = 'visibility_off';
                icone.style.color = '#7f8c8d';
            }
        }

        // Gestion de l'affichage sécurisé
        function gererChangementPhoto(evenement, inputId) {
            const fichiers = evenement.target.files;
            
            if (fichiers && fichiers.length > 0) {
                const nomFichier = fichiers[0].name; // Récupère le vrai nom de la photo
                const lecteur = new FileReader();
                
                lecteur.onload = function(e) {
                    // 1. Masquer l'icône de la caméra
                    if (document.getElementById('ic-' + inputId)) {
                        document.getElementById('ic-' + inputId).style.display = 'none';
                    }
                    
                    // 2. Écrire le nom du fichier en gros et en vert pour rassurer l'utilisateur
                    const texteAide = document.getElementById('txt-' + inputId);
                    if (texteAide) {
                        texteAide.innerHTML = "✅ Fichier sélectionné : <br><strong style='color:#81c784; font-size:14px;'>" + nomFichier + "</strong>";
                        texteAide.style.display = 'block';
                    }
                    
                    // 3. Afficher l'image en tâche de fond si la RAM le permet
                    const baliseImg = document.getElementById('img-' + inputId);
                    if (baliseImg) {
                        baliseImg.src = e.target.result;
                        baliseImg.style.display = 'block';
                    }
                    
                    // 4. Allumer la croix rouge de suppression (×)
                    if (document.getElementById('croix-' + inputId)) {
                        document.getElementById('croix-' + inputId).style.display = 'flex';
                    }
                };
                
                lecteur.readAsDataURL(fichiers);
            }
        }

        // Action de la Croix (X) : Nettoyage complet
        function effacerPhotoSelectionnee(evenement, inputId) {
            if (evenement) {
                evenement.preventDefault();
                evenement.stopPropagation();
            }
            
            const inputElement = document.getElementById(inputId);
            inputElement.value = ""; // Vide le fichier

            // Réinitialisation complète des textes et images
            if (document.getElementById('img-' + inputId)) {
                document.getElementById('img-' + inputId).style.display = 'none';
                document.getElementById('img-' + inputId).src = "#";
            }
            if (document.getElementById('croix-' + inputId)) {
                document.getElementById('croix-' + inputId).style.display = 'none';
            }
            
            // Retour à l'état initial
            if (document.getElementById('ic-' + inputId)) {
                document.getElementById('ic-' + inputId).style.display = 'inline-block';
            }
            const texteAide = document.getElementById('txt-' + inputId);
            if (texteAide) {
                if (inputId === 'fichVehicule') {
                    texteAide.innerText = "Prenez une photo claire de votre engin avec plaque visible";
                } else if (inputId === 'fichCniVerso') {
                    texteAide.innerText = "Cliquez pour prendre le VERSO ou ouvrir la galerie";
                } else {
                    texteAide.innerText = "Cliquez pour prendre le RECTO ou ouvrir la galerie";
                }
            }
        }
    </script>
</body>
</html>
