  <!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jula Express — Espace Logistique Coursier</title>
    <!-- Icônes Modernes Google Material Sécurisées -->
    <link href="https://googleapis.com" rel="stylesheet">
    <style>
        :root { 
            --jula-orange: #f57c00; 
            --jula-vert: #2e7d32; 
            --dark-bg: #111417; 
            --card-bg: #1a1d21;
            --border-color: #2d3139;
        }
        body { font-family: 'Segoe UI', system-ui, sans-serif; background-color: var(--dark-bg); margin: 0; padding: 20px; color: #ecf0f1; }
        .content-container { max-width: 900px; margin: 0 auto; }
        
        .header-driver { background: var(--card-bg); padding: 20px 25px; border-radius: 12px; margin-bottom: 25px; display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--border-color); border-bottom: 4px solid var(--jula-vert); box-shadow: 0 10px 25px rgba(0,0,0,0.2); }
        .header-driver h1 { margin: 0; font-size: 20px; display: flex; align-items: center; gap: 8px; font-weight: 800; }
        
        .status-badge-active { background: rgba(46, 125, 50, 0.1); color: #81c784; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: bold; border: 1px solid rgba(46, 125, 50, 0.2); }
        .btn-logout { background: #c62828; color: white; border: none; padding: 10px 18px; border-radius: 6px; cursor: pointer; text-decoration: none; font-size: 13px; font-weight: bold; display: flex; align-items: center; gap: 4px; transition: 0.2s; }
        .btn-logout:hover { background: #b71c1c; }
        
        /* ⚙️ BLOC PARAMÈTRES SÉCURISÉ */
        .card-parametres { background: var(--card-bg); border-radius: 12px; padding: 24px; margin-bottom: 20px; border: 1px solid var(--border-color); }
        .input-securise { background: var(--dark-bg); border: 1px solid var(--border-color); color: #fff; padding: 10px 14px; border-radius: 6px; font-size: 14px; width: 200px; }
        
        .btn-oeil { background: none; border: none; color: #7f8c8d; cursor: pointer; vertical-align: middle; margin-left: -40px; outline: none; }
        .btn-oeil:hover { color: var(--jula-orange); }

        .zone-avatar { display: flex; align-items: center; gap: 15px; margin-bottom: 20px; }
        .img-avatar { width: 70px; height: 70px; border-radius: 50%; object-fit: cover; border: 2px solid var(--jula-orange); background: #333; }
        .btn-photo-modif { background: rgba(16, 114, 186, 0.15); color: #29b6f6; border: 1px solid rgba(16, 114, 186, 0.25); padding: 8px 12px; border-radius: 6px; font-size: 12px; font-weight: bold; cursor: pointer; }

        .grille-missions { display: grid; grid-template-columns: 1fr; gap: 15px; margin-top: 20px; }
        .card-mission { background: var(--card-bg); border-radius: 12px; padding: 20px; border: 1px solid var(--border-color); border-left: 5px solid var(--jula-orange); }
    </style>
</head>
<body>

    <div class="content-container">
        <!-- 🪐 EN-TÊTE DE L'ESPACE PRIVÉ LIVREUR -->
        <div class="header-driver">
            <h1><span class="material-icons-round" style="color: var(--jula-vert);">two_wheeler</span> Espace Coursier Réel Jula</h1>
            <div style="display: flex; align-items: center; gap: 15px;">
                <span class="status-badge-active">● Connecté & Disponible</span>
                <a href="/login" class="btn-logout"><span class="material-icons-round" style="font-size: 16px;">power_settings_new</span> Fermer la session</a>
            </div>
        </div>

        <!-- 🛡️ BLOC DE GESTION DU PROFIL (FRANÇAIS PROPRE) -->
        <div class="card-parametres">
            <h3 style="margin-top: 0; color: #fff; display: flex; align-items: center; gap: 6px;"><span class="material-icons-round" style="color: var(--jula-orange); font-size: 20px;">manage_accounts</span> Gestion de votre profil coursier</h3>
            
            <!-- Modification de la photo de profil -->
            <div class="zone-avatar">
                <img src="https://unsplash.com" id="avatarLivreur" class="img-avatar" alt="Profil">
                <div>
                    <label style="display: block; font-size: 13px; font-weight: bold; margin-bottom: 6px;">Photo de profil officielle</label>
                    <input type="file" id="selecteurAvatar" accept="image/*" style="display: none;" onchange="changerPhotoEnDirect(event)">
                    <button type="button" class="btn-photo-modif" onclick="document.getElementById('selecteurAvatar').click()"><span class="material-icons-round" style="font-size: 14px; vertical-align: middle;">photo_camera</span> Modifier ma photo</button>
                </div>
            </div>

            <!-- Visualisation du mot de passe sécurisé -->
            <div style="margin-top: 15px;">
                <label style="display: inline-block; width: 150px; font-size: 13.5px; font-weight: 600;">Mot de passe secret :</label>
                <input type="password" id="champMotDePasse" class="input-securise" value="JulaExpress2026" readonly>
                <button type="button" class="btn-oeil" onclick="basculerAffichageMotDePasse()">
                    <span class="material-icons-round" id="iconeOeil" style="font-size: 20px; vertical-align: middle;">visibility</span>
                </button>
                <span style="font-size: 12px; color: #7f8c8d; margin-left: 15px;">✉️ Compte : <%= email %></span>
            </div>
        </div>

        <h2>📦 Votre Feuille de Route en Direct</h2>
        
        <div class="grille-missions">
            <% if (orders.length === 0) { %>
                <div style="text-align: center; padding: 40px; background: var(--card-bg); border-radius: 12px; color: #7f8c8d; border: 1px dashed var(--border-color);">
                    <span class="material-icons-round" style="font-size: 48px; display: block; margin-bottom: 10px;">sports_motorsports</span>
                    Aucune livraison disponible dans votre secteur pour le moment.
                </div>
            <% } else { %>
                <% orders.forEach(function(order) { %>
                    <div class="card-mission">
                        <h3 style="margin: 5px 0; color: #fff;"><%= order.product_title %></h3>
                        <p style="margin: 5px 0; font-size: 14px;">📍 <b>Adresse :</b> <%= order.buyer_address %></p>
                        <p style="margin: 5px 0; font-size: 15px; font-weight: bold; color: #81c784;">💰 Encaisser : <%= order.total_price %> FCFA</p>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </div>

    <!-- ⚙️ LE MOTEUR DE SÉCURITÉ DU PROFIL -->
    <script>
        // 1. VOIR ET MASQUER LE MOT DE PASSE EN 1 CLIC
        function basculerAffichageMotDePasse() {
            const champ = document.getElementById('champMotDePasse');
            const icone = document.getElementById('iconeOeil');
            if (champ.type === 'password') {
                champ.type = 'text';
                icone.innerText = 'visibility_off';
                icone.style.color = 'var(--jula-orange)';
            } else {
                champ.type = 'password';
                icone.innerText = 'visibility';
                icone.style.color = '#7f8c8d';
            }
        }

        // 2. CHANGER LA PHOTO DE PROFIL ET APERCEVOIR LE RÉSULTAT
        function changerPhotoEnDirect(evenement) {
            const fichier = evenement.target.files[0];
            if (fichier) {
                const lecteur = new FileReader();
                lecteur.onload = function(e) {
                    document.getElementById('avatarLivreur').src = e.target.result;
                    alert('📸 Nouvelle photo chargée dans l’application !');
                };
                lecteur.readAsDataURL(fichier);
            }
        }
    </script>
</body>
</html>
