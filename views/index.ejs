<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portail Jula — Réseau Commercial et Logistique Interconnecté</title>
    <!-- CHARGEUR UNIVERSEL FONTAWESOME POUR ASSURER LES 3 TRAITS HORIZONTAUX -->
    <link rel="stylesheet" href="https://cloudflare.com">
    <style>
        :root { 
            --jula-orange: #f57c00; 
            --jula-blue: #1072ba; 
            --jula-vert: #2e7d32; 
            --fond-carte: #ffffff; 
            --couleur-bordure: #dee2e6; 
            --fond-sombre: #f8f9fa; 
        }
        body { font-family: 'Segoe UI', system-ui, sans-serif; background-color: var(--fond-sombre); margin: 0; padding: 0; color: #212529; line-height: 1.6; overflow-x: hidden; }
        
        /* 🪐 🟢 CORRECTIF CONTRASTE : BARRE SUPÉRIEURE EN ARDOISE SOMBRE POUR BIEN DÉTACHER LES 3 TRAITS BLANCS */
        .barre-navigation { background-color: #1e2229 !important; border-bottom: 3px solid var(--jula-orange); padding: 10px 24px; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 1100; height: 65px; box-sizing: border-box; box-shadow: 0 4px 15px rgba(0,0,0,0.2); }
        .declencheur-menu { background: none; border: none; color: #ffffff !important; cursor: pointer; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 8px; transition: all 0.2s; outline: none; }
        .declencheur-menu:hover { background-color: rgba(255, 255, 255, 0.1); color: var(--jula-orange) !important; }
        .logo-navigation { font-size: 19px; font-weight: 800; color: #ffffff !important; display: flex; align-items: center; gap: 8px; letter-spacing: 0.5px; }

        /* 🪐 PANNEAU DE NAVIGATION COULISSANT GAUCHE PROFESSIONNEL */
        .panneau-navigation { position: fixed; top: 0; left: -320px; width: 310px; height: 100%; background-color: #1a1d21; border-right: 1px solid #2d3139; z-index: 1200; padding: 25px 20px; transition: left 0.3s ease; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 5px 0 25px rgba(0,0,0,0.4); box-sizing: border-box; }
        .panneau-navigation.actif { left: 0; }
        .entete-panneau { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #2d3139; padding-bottom: 15px; }
        .titre-panneau { font-size: 14px; font-weight: 800; color: var(--jula-orange); display: flex; align-items: center; gap: 8px; text-transform: uppercase; color: #fff; }
        .bouton-fermer { background: none; border: none; color: #7f8c8d; cursor: pointer; display: flex; align-items: center; transition: color 0.2s; outline: none; }
        .bouton-fermer:hover { color: var(--jula-orange); }
        
        .menu-navigation { display: flex; flex-direction: column; gap: 4px; flex: 1; margin-top: 15px; }
        .label-section-menu { font-size: 11px; color: #7f8c8d; font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 15px; margin-bottom: 5px; padding-left: 5px; display: block; }
        
        .lien-navigation { display: flex; align-items: center; gap: 12px; color: #ecf0f1; text-decoration: none; padding: 11px 14px; border-radius: 6px; font-size: 13.5px; font-weight: 500; transition: all 0.2s; }
        .lien-navigation:hover { background: rgba(255, 255, 255, 0.04); color: var(--jula-orange); }
        .lien-navigation.onglet-actif { background: rgba(245, 124, 0, 0.1); color: var(--jula-orange); font-weight: bold; }
        
        .bas-panneau { border-top: 1px solid #2d3139; padding-top: 15px; display: flex; flex-direction: column; gap: 8px; }
        .bouton-panneau-bleu { display: flex; align-items: center; justify-content: center; gap: 8px; background-color: rgba(16, 114, 186, 0.15); color: #29b6f6; border: 1px solid rgba(16, 114, 186, 0.25); text-decoration: none; padding: 11px; border-radius: 6px; font-size: 13px; font-weight: bold; transition: all 0.2s; }
        .bouton-panneau-vert { display: flex; align-items: center; justify-content: center; gap: 8px; background-color: rgba(46, 125, 50, 0.15); color: #81c784; border: 1px solid rgba(46, 125, 50, 0.25); text-decoration: none; padding: 11px; border-radius: 6px; font-size: 13px; font-weight: bold; transition: all 0.2s; }
        
        /* 🌌 VITRINE COMMERCIALE */
        .vitrine-principale { background: linear-gradient(135deg, #111417, #1072ba); color: white; padding: 60px 20px; text-align: center; }
        .insigne-vitrine { background: var(--jula-orange); color: white; padding: 6px 14px; border-radius: 30px; font-size: 11px; font-weight: bold; text-transform: uppercase; display: inline-block; margin-bottom: 15px; }
        .vitrine-principale h1 { font-size: 32px; margin: 0 0 12px 0; font-weight: 800; line-height: 42px; color: #ffffff; }
        .vitrine-principale p { font-size: 16px; max-width: 700px; margin: 0 auto 25px auto; opacity: 0.95; color: #ffffff; }
        .boutons-vitrine { display: flex; justify-content: center; gap: 15px; flex-wrap: wrap; }
        .bouton-orange { background-color: var(--jula-orange); color: white; padding: 12px 28px; border-radius: 6px; font-weight: bold; text-decoration: none; font-size: 14.5px; box-shadow: 0 4px 12px rgba(245,124,0,0.3); transition: 0.2s; }
        .bouton-transparent { background-color: transparent; color: white; padding: 12px 28px; border-radius: 6px; font-weight: bold; text-decoration: none; font-size: 14.5px; border: 2px solid white; transition: 0.2s; }
        
        .conteneur { max-width: 1100px; margin: 0 auto; padding: 40px 20px; box-sizing: border-box; }
        .titre-section { text-align: center; margin-top: 10px; margin-bottom: 35px; }
        .titre-section h2 { font-size: 26px; color: #212529; margin: 0 0 10px 0; font-weight: 700; }
        .titre-section p { color: #495057; font-size: 15px; margin: 0; }
        .grille-etapes { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 25px; margin-bottom: 50px; }
        .carte-etape { background: var(--fond-carte); padding: 30px; border-radius: 12px; border: 1px solid var(--couleur-bordure); border-bottom: 4px solid var(--jula-blue); position: relative; box-shadow: 0 4px 15px rgba(0,0,0,0.04); }
        .numero-etape { font-size: 44px; font-weight: 900; color: rgba(16,114,186,0.08); position: absolute; top: 15px; right: 25px; }
        .carte-etape h3 { font-size: 18px; margin: 0 0 10px 0; color: var(--jula-blue); font-weight: 700; }
        .carte-etape p { margin: 0; color: #212529; font-size: 14px; }
    </style>
</head>
<body>

    <!-- 🪐 PANNEAU DE NAVIGATION COULISSANT GAUCHE -->
    <div class="panneau-navigation" id="panneauJula">
        <div style="display: flex; flex-direction: column; flex: 1;">
            <div class="entete-panneau">
                <div class="titre-panneau"><i class="fa-solid fa-bars-staggered" style="color: var(--jula-orange);"></i> Options de Navigation</div>
                <button class="bouton-fermer" onclick="basculerMenuJula()"><i class="fa-solid fa-xmark" style="font-size: 22px;"></i></button>
            </div>
            <div class="menu-navigation">
                <span class="label-section-menu">🏠 Navigation</span>
                <a href="/" class="lien-navigation onglet-actif"><i class="fa-solid fa-house"></i> Accueil du Portail Jula</a>
                
                <span class="label-section-menu">💼 Espaces Professionnels</span>
                <a href="/login" class="lien-navigation"><i class="fa-solid fa-key"></i> Connexion Compte Pro</a>
                <a href="/jacky-superadmin-control" class="lien-navigation" style="border: 1px dashed rgba(245,124,0,0.4); border-radius: 6px;"><i class="fa-solid fa-user-shield" style="color: var(--jula-orange);"></i> Espace Secret Jacky</a>
                
                <span class="label-section-menu">🏢 Coordonnées Entreprise</span>
                <div style="padding: 12px; background: rgba(255,255,255,0.02); border-radius: 6px; border: 1px solid #2d3139;">
                    <p style="font-size: 13px; color: #fff; margin: 0; display: flex; align-items: center; gap: 8px;"><i class="fa-solid fa-envelope" style="color: var(--jula-blue);"></i> support@jula-network.com</p>
                    <p style="font-size: 11px; color: var(--jula-orange); margin: 6px 0 0 0; font-weight: bold; display: flex; align-items: center; gap: 8px;"><i class="fa-solid fa-arrows-rotate"></i> Catalogue synchronisé</p>
                </div>
            </div>
        </div>
        <div class="bas-panneau">
            <a href="/politique-confidentialite" class="bouton-panneau-bleu"><i class="fa-solid fa-gavel"></i> Charte de Confidentialité</a>
            <a href="#fonctionnement" class="bouton-panneau-vert" onclick="basculerMenuJula()"><i class="fa-solid fa-circle-question"></i> Guide d'utilisation du site</a>
        </div>
    </div>

    <!-- 🪐 LES 3 BARRES HORIZONTALES ☰ ET LE NOM QUI FLASHENT EN BLANC SÉCURISÉ -->
    <nav class="barre-navigation">
        <button class="declencheur-menu" onclick="basculerMenuJula()">
            <i class="fa-solid fa-bars" style="font-size: 30px; color: #ffffff !important;"></i> <!-- ☰ ICI LES 3 TRAITS RESSORTENT FIÈREMENT EN BLANC -->
        </button>
        <div class="logo-navigation">
            <i class="fa-solid fa-circle-nodes" style="color: var(--jula-orange); font-size: 20px;"></i>
            RÉSEAU JULA <!-- 🟢 LE NOM DU PORTAIL BRILLE EN BLANC PUR -->
        </div>
        <div style="width: 44px;"></div>
    </nav>
    <!-- 🌠 VITRINE COMMERCIALE ALIGNÉE -->
    <div class="vitrine-principale">
        <span class="insigne-vitrine">Portail Officiel Jula Afrique de l'Ouest</span>
        <h1>Devenez Partenaire Jula & Boostez vos Revenus</h1>
        <p>Rejoignez l'écosystème commercial interconnecté leader en Côte d'Ivoire, au Sénégal, au Togo et au Bénin. Vendez ou livrez en toute liberté.</p>
        <div class="boutons-vitrine">
