    <!-- ⚙️ LE MOTEUR JAVASCRIPT CORRIGÉ EN FRANÇAIS POUR LA NAVIGATION -->
    <script>
        function basculerMenuJula() {
            const panneau = document.getElementById('panneauJula');
            if (panneau) {
                panneau.classList.toggle('actif');
            }
        }

        // Fermer automatiquement le tiroir si le doigt clique en dehors du menu
        document.addEventListener('click', function(evenement) {
            const panneau = document.getElementById('panneauJula');
            const declencheur = document.querySelector('.declencheur-menu');
            
            if (panneau && panneau.classList.contains('actif')) {
                if (!panneau.contains(evenement.target) && !declencheur.contains(evenement.target)) {
                    panneau.classList.remove('actif');
                }
            }
        });
    </script>
