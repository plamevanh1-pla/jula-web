            <table class="pricing-table" style="width: 100%; border-collapse: collapse; text-align: left;">
                <thead>
                    <tr>
                        <th style="background-color: rgba(255, 255, 255, 0.02); color: #fff; padding: 15px; font-weight: bold; border-bottom: 2px solid var(--border-color);">Taille du Produit</th>
                        <th style="background-color: rgba(255, 255, 255, 0.02); color: #fff; padding: 15px; font-weight: bold; border-bottom: 2px solid var(--border-color);">Exemples d'articles</th>
                        <th style="background-color: rgba(255, 255, 255, 0.02); color: #fff; padding: 15px; font-weight: bold; border-bottom: 2px solid var(--border-color);">Stockage (Par mois / Unité)</th>
                        <th style="background-color: rgba(255, 255, 255, 0.02); color: #fff; padding: 15px; font-weight: bold; border-bottom: 2px solid var(--border-color);">Emballage & Préparation</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="padding: 15px; border-bottom: 1px solid var(--border-color); font-size: 14.5px;"><b>Petit produit</b></td>
                        <td style="padding: 15px; border-bottom: 1px solid var(--border-color); font-size: 14.5px;">Smartphones, Bijoux, Écouteurs, Maquillage</td>
                        <td style="padding: 15px; border-bottom: 1px solid var(--border-color); font-size: 14.5px; font-weight: bold; color: var(--jula-orange);">500 FCFA</td>
                        <td style="padding: 15px; border-bottom: 1px solid var(--border-color); font-size: 14.5px;">300 FCFA /colis expédié</td>
                    </tr>
                    <tr>
                        <td style="padding: 15px; border-bottom: 1px solid var(--border-color); font-size: 14.5px;"><b>Moyen produit</b></td>
                        <td style="padding: 15px; border-bottom: 1px solid var(--border-color); font-size: 14.5px;">Ordinateurs portables, Micro-ondes, Mixeurs, Sacs de mode</td>
                        <td style="padding: 15px; border-bottom: 1px solid var(--border-color); font-size: 14.5px; font-weight: bold; color: var(--jula-orange);">1 500 FCFA</td>
                        <td style="padding: 15px; border-bottom: 1px solid var(--border-color); font-size: 14.5px;">400 FCFA /colis expédié</td>
                    </tr>
                    <tr>
                        <td style="padding: 15px; border-bottom: 1px solid var(--border-color); font-size: 14.5px;"><b>Gros produit</b></td>
                        <td style="padding: 15px; border-bottom: 1px solid var(--border-color); font-size: 14.5px;">Téléviseurs, Réfrigérateurs, Ventilateurs sur pied</td>
                        <td style="padding: 15px; border-bottom: 1px solid var(--border-color); font-size: 14.5px; font-weight: bold; color: var(--jula-orange);">3 000 FCFA</td>
                        <td style="padding: 15px; border-bottom: 1px solid var(--border-color); font-size: 14.5px;">600 FCFA /colis expédié</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- 5. FOIRE AUX QUESTIONS (FAQ) -->
        <div class="section-title">
            <h2>Questions Fréquentes</h2>
            <p>Tout ce que vous devez savoir pour démarrer sereinement</p>
        </div>
        <div class="faq-section" style="background: var(--card-bg); padding: 40px; border-radius: 16px; margin-bottom: 60px; border: 1px solid var(--border-color);">
            <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 20px 0;">
                <div class="faq-q" style="font-weight: 700; font-size: 16px; color: #fff; margin-bottom: 8px; display: flex; align-items: center; gap: 10px;">❓ L'inscription sur Jula est-elle payante ?</div>
                <p class="faq-a" style="color: #95a5a6; font-size: 14px; margin: 0; padding-left: 5px; line-height: 22px;">Non, l'ouverture de compte et la publication classique des produits sur la plateforme sont totalement gratuites pour tous les partenaires.</p>
            </div>
            <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 20px 0;">
                <div class="faq-q" style="font-weight: 700; font-size: 16px; color: #fff; margin-bottom: 8px; display: flex; align-items: center; gap: 10px;">❓ Comment s'effectue le retrait de mes gains en zone CFA ?</div>
                <p class="faq-a" style="color: #95a5a6; font-size: 14px; margin: 0; padding-left: 5px; line-height: 22px;">Vos fonds sont bloqués de manière sécurisée et débloqués automatiquement via Jula Pay instantanément dès que l'acheteur confirme la réception de la marchandise.</p>
            </div>
            <div class="faq-item" style="border-bottom: 1px solid var(--border-color); padding: 20px 0;">
                <div class="faq-q" style="font-weight: 700; font-size: 16px; color: #fff; margin-bottom: 8px; display: flex; align-items: center; gap: 10px;">🍊 Qu'est-ce que le service "Jula Express" ?</div>
                <p class="faq-a" style="color: #95a5a6; font-size: 14px; margin: 0; padding-left: 5px; line-height: 22px;">C'est notre service de traitement logistique d'élite. Vous déposez vos stocks à l'avance dans notre entrepôt central Jula. Dès qu'un client commande, nos équipes s'occupent de l'emballage professionnel et de l'expédition immédiate sous 2 heures, sans que vous n'ayez à vous déplacer !</p>
            </div>
            <div class="faq-item" style="border-top: none; padding: 20px 0 0 0;">
                <div class="faq-q" style="font-weight: 700; font-size: 16px; color: #fff; margin-bottom: 8px; display: flex; align-items: center; gap: 10px;">❓ Dans quels pays le réseau Jula opère-t-il ?</div>
                <p class="faq-a" style="color: #95a5a6; font-size: 14px; margin: 0; padding-left: 5px; line-height: 22px;">Jula interconnecte quatre marchés clés d'Afrique de l'Ouest : la Côte d'Ivoire, le Sénégal, le Togo et le Bénin.</p>
            </div>
        </div>

        <!-- 🚀 EMBALLAGE D'ANNONCE GOOGLE PLAY STORE -->
        <div style="margin: 20px auto; max-width: 900px; padding: 20px; background: rgba(255, 255, 255, 0.02); border-radius: 12px; text-align: center; border: 1px solid var(--border-color); border-left: 5px solid var(--jula-orange);">
            <p style="margin: 0; font-weight: bold; color: #fff; font-size: 14.5px; letter-spacing: 0.3px;">
                📱 L'application officielle Jula arrive très bientôt en téléchargement sécurisé sur le Google Play Store !
            </p>
        </div>

        <!-- 🔒 FOOTER SÉCURISÉ RESTRUCTURÉ -->
        <div class="footer" style="text-align: center; padding-top: 40px; border-top: 1px solid var(--border-color); font-size: 13px; color: #7f8c8d; font-weight: 500; margin-top: 40px;">
            <p>© 2026 Jula Logistique & Co. • Interconnexion Ouest-Africaine • Abidjan - Dakar - Lomé - Cotonou • UEMOA Tech v1.1.0</p>
        </div>

    </div> <!-- Fermeture du .container principal -->

    <!-- ⚙️ LE MOTEUR JAVASCRIPT DE TA SIDEBAR INTERACTIVE -->
    <script>
        function toggleJulaSidebar() {
            const sidebar = document.getElementById('julaSidebar');
            if (sidebar) {
                sidebar.classList.toggle('active');
            }
        }

        // Fermer la Sidebar automatiquement si le grossiste clique en dehors du menu
        document.addEventListener('click', function(event) {
            const sidebar = document.getElementById('julaSidebar');
            const menuTrigger = document.querySelector('.btn-menu-trigger');
            
            if (sidebar && sidebar.classList.contains('active')) {
                if (!sidebar.contains(event.target) && !menuTrigger.contains(event.target)) {
                    sidebar.classList.remove('active');
                }
            }
        });
    </script>
</body>
</html>

        
      
