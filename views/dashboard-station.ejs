 <!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jula Express — Espace Gérant Point Relais</title>
    <!-- Icônes Modernes Google Material Sécurisées -->
    <link href="https://googleapis.com" rel="stylesheet">
    <style>
        :root { 
            --jula-orange: #f57c00; 
            --jula-vert: #2e7d32; 
            --dark-bg: #111417; 
            --card-bg: #1a1d21;
            --border-color: #2d3139;
            --success: #81c784;
        }
        body { font-family: 'Segoe UI', system-ui, sans-serif; background-color: var(--dark-bg); margin: 0; padding: 20px; color: #ecf0f1; }
        
        .header-station { background: var(--card-bg); padding: 20px 25px; border-radius: 12px; margin-bottom: 25px; display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--border-color); border-bottom: 4px solid var(--jula-orange); box-shadow: 0 10px 25px rgba(0,0,0,0.2); }
        .header-station h1 { margin: 0; font-size: 20px; display: flex; align-items: center; gap: 8px; font-weight: 800; }
        
        .status-badge-active { background: rgba(245, 124, 0, 0.1); color: var(--jula-orange); padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: bold; border: 1px solid rgba(245, 124, 0, 0.2); }
        
        .content-container { max-width: 800px; margin: 0 auto; }
        .card-station-info { background: var(--card-bg); border-radius: 12px; padding: 24px; margin-bottom: 15px; border: 1px solid var(--border-color); box-shadow: 0 4px 15px rgba(0,0,0,0.15); }
        
        .btn-logout { background: transparent; border: 1px solid var(--border-color); color: #7f8c8d; padding: 8px 16px; border-radius: 6px; cursor: pointer; text-decoration: none; font-size: 13px; font-weight: 600; transition: all 0.2s; }
        .btn-logout:hover { color: #fff; border-color: #fff; background: rgba(255,255,255,0.02); }
    </style>
</head>
<body>
    <div class="content-container">
        <!-- 🪐 EN-TÊTE DE L'SPACE MEMBRE PRIVÉ POINT RELAIS -->
        <div class="header-station">
            <h1><span class="material-icons-round" style="color: var(--jula-orange);">storefront</span> Espace Gérant Point Relais Jula</h1>
            <div style="display: flex; align-items: center; gap: 15px;">
                <span class="status-badge-active">● Guichet Agréé & Actif</span>
                <a href="/" class="btn-logout">Déconnexion</a>
            </div>
        </div>

        <!-- 📦 COMPARTIMENT STATISTIQUES ET COMMISSIONS DE STOCKAGE -->
        <div style="margin-bottom: 20px;"><b style="color: var(--jula-orange);">👤 Identifiant de l'Espace :</b> <%= email %></div>
        
        <div class="card-station-info">
            <h3 style="margin-top: 0; color: #fff; display: flex; align-items: center; gap: 6px;">
                <span class="material-icons-round" style="color: var(--jula-orange); font-size: 18px;">inventory_2</span> 
                Inventaire des Colis de Smartphones de Test
            </h3>
            <p style="font-size: 14px; color: #7f8c8d; margin-bottom: 0; line-height: 22px;">
                Félicitations Jacky ! Ton faux compte de Point Relais fonctionne désormais à merveille. Cet espace privé et crypté affichera en temps réel les colis déposés par les grossistes d'Adjamé et retirés par les clients de ton quartier dès l'activation générale du réseau [1.1].
            </p>
        </div>
    </div>

</body>
</html>
