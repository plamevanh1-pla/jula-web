<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jula Express — Console Financière & Comptabilité</title>
    <!-- Icônes Modernes Google Material Sécurisées -->
    <link href="https://googleapis.com" rel="stylesheet">
    <style>
        :root { 
            --jula-orange: #f57c00; 
            --jula-blue: #1072ba; 
            --dark-bg: #111417; 
            --card-bg: #1a1d21;
            --border-color: #2d3139;
            --finance-green: #2e7d32;
        }
        body { font-family: 'Segoe UI', system-ui, sans-serif; background-color: var(--dark-bg); margin: 0; padding: 20px; color: #ecf0f1; }
        .content-container { max-width: 1000px; margin: 0 auto; }
        
        .header-finance { background: var(--card-bg); padding: 20px 25px; border-radius: 12px; margin-bottom: 25px; display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--border-color); border-bottom: 4px solid var(--finance-green); box-shadow: 0 10px 25px rgba(0,0,0,0.2); }
        .header-finance h1 { margin: 0; font-size: 20px; display: flex; align-items: center; gap: 8px; font-weight: 800; }
        
        .status-badge-finance { background: rgba(46, 125, 50, 0.1); color: #81c784; padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: bold; border: 1px solid rgba(46, 125, 50, 0.2); }
        .btn-logout { background: transparent; border: 1px solid var(--border-color); color: #7f8c8d; padding: 8px 16px; border-radius: 6px; cursor: pointer; text-decoration: none; font-size: 13px; font-weight: 600; }
        .btn-logout:hover { color: #fff; border-color: #fff; }
        
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .stat-card { background: var(--card-bg); border: 1px solid var(--border-color); padding: 20px; border-radius: 10px; border-left: 4px solid var(--finance-green); }
        
        table { width: 100%; border-collapse: collapse; margin-top: 15px; background: var(--card-bg); border-radius: 8px; overflow: hidden; border: 1px solid var(--border-color); }
        th, td { padding: 12px 15px; text-align: left; font-size: 14px; }
        th { background: #1f2327; color: #7f8c8d; font-weight: bold; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px; border-bottom: 2px solid var(--border-color); }
        td { border-bottom: 1px solid var(--border-color); color: #fff; }
        tr:hover { background: rgba(255,255,255,0.01); }
    </style>
</head>
<body>

    <div class="content-container">
        <!-- 🪐 EN-TÊTE DE LA CONSOLE COMPTABLE -->
        <div class="header-finance">
            <h1><span class="material-icons-round" style="color: var(--finance-green);">account_balance</span> Bureau de la Comptabilité Jula</h1>
            <div style="display: flex; align-items: center; gap: 15px;">
                <span class="status-badge-finance">● Session Comptable Ouverte</span>
                <a href="/login" class="btn-logout">Déconnexion</a>
            </div>
        </div>

        <div style="margin-bottom: 25px;"><b style="color: var(--finance-green);">👤 Agent Comptable :</b> <%= email %></div>

        <!-- 📊 COMPTEURS MACRO-ÉCONOMIQUES -->
        <div class="stats-grid">
            <div class="stat-card">
                <span style="font-size: 11px; color: #7f8c8d; font-weight: bold; text-transform: uppercase;">💰 Flux d'Affaires Brut</span>
                <div style="font-size: 24px; font-weight: bold; margin-top: 8px;"><%= caGlobal.toLocaleString('fr-FR') %> <span style="font-size:16px; color:var(--jula-orange);">FCFA</span></div>
            </div>
            <div class="stat-card" style="border-left-color: var(--jula-blue);">
                <span style="font-size: 11px; color: #7f8c8d; font-weight: bold; text-transform: uppercase;">📈 Prélèvement Commission Jula (10%)</span>
                <div style="font-size: 24px; font-weight: bold; margin-top: 8px; color: #29b6f6;"><%= (caGlobal * 0.1).toLocaleString('fr-FR') %> <span style="font-size:16px;">FCFA</span></div>
            </div>
        </div>

        <h2>📑 Registre Général des Transactions Réelles</h2>
        <div style="overflow-x: auto; margin-top: 15px;">
            <table>
                <thead>
                    <tr>
                        <th>Référence Colis</th>
                        <th>Article Connecté</th>
                        <th>Montant Brut</th>
                        <th>Client Destinataire</th>
                        <th>Contact Mobile</th>
                        <th>Statut Flux</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (orders.length === 0) { %>
                        <tr>
                            <td colspan="6" style="text-align: center; color: #7f8c8d; padding: 30px; font-style: italic;">
                                📋 Aucun mouvement comptable ou encaissement enregistré pour le moment.
                            </td>
                        </tr>
                    <% } else { %>
                        <% orders.forEach(function(order) { %>
                            <tr>
                                <td style="font-family: monospace; font-weight: bold; color: var(--jula-blue);">#<%= order.id %></td>
                                <td><%= order.product_title %></td>
                                <td style="font-weight: bold; color: #81c784;"><%= Number(order.total_price || 0).toLocaleString('fr-FR') %> <span style="font-size: 11px;">CFA</span></td>
                                <td><%= order.buyer_email %></td>
                                <td><%= order.buyer_phone || 'Non renseigné' %></td>
                                <td>
                                    <% if (order.status === 'Livré') { %>
                                        <span style="color: #81c784; background: rgba(46, 125, 50, 0.1); padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold;">✔ Encaissé</span>
                                    <% } else if (order.status === 'En cours de livraison') { %>
                                        <span style="color: #ffb74d; background: rgba(245, 124, 0, 0.1); padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold;">🏍 Transit</span>
                                    <% } else { %>
                                        <span style="color: #7f8c8d; background: rgba(255,255,255,0.05); padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold;">⏳ Stock</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div> <!-- Fin du conteneur .content-container principal -->

</body>
</html>
