<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Espace Grossiste Jula — Publier un Article</title>
    <!-- Chargement du moteur d'icônes universel FontAwesome -->
    <link rel="stylesheet" href="https://cloudflare.com">
    <style>
        :root { 
            --jula-orange: #f57c00; 
            --jula-blue: #1072ba; 
            --couleur-bordure: #dee2e6; 
            --fond-sombre: #f8f9fa; 
        }
        body { font-family: 'Segoe UI', system-ui, sans-serif; background-color: var(--fond-sombre); margin: 0; padding: 0; color: #212529; line-height: 1.6; }
        
        .barre-superieure { background-color: #1072ba; border-bottom: 3px solid var(--jula-orange); padding: 15px 24px; display: flex; justify-content: space-between; align-items: center; color: #ffffff; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .titre-barre { font-size: 18px; font-weight: 800; display: flex; align-items: center; gap: 8px; }
        .bouton-deconnexion { color: #ffffff; text-decoration: none; font-weight: bold; font-size: 14px; background: rgba(255,255,255,0.15); padding: 8px 16px; border-radius: 6px; transition: 0.2s; }
        .bouton-deconnexion:hover { background-color: #d32f2f; }

        .conteneur { max-width: 700px; margin: 30px auto; padding: 0 20px; box-sizing: border-box; }
        .carte-formulaire { background: #ffffff; border-radius: 12px; padding: 30px; border: 1px solid var(--couleur-bordure); box-shadow: 0 4px 20px rgba(0,0,0,0.05); }
        .carte-formulaire h2 { font-size: 22px; color: #212529; margin-top: 0; margin-bottom: 20px; font-weight: 700; border-bottom: 2px solid var(--fond-sombre); padding-bottom: 10px; }
        
        .groupe-champ { margin-bottom: 20px; }
        .groupe-champ label { display: block; font-size: 14px; font-weight: bold; color: #495057; margin-bottom: 8px; }
        .champ-saisie { width: 100%; padding: 12px; border: 1px solid var(--couleur-bordure); border-radius: 6px; font-size: 14.5px; box-sizing: border-box; transition: border-color 0.2s; background: #ffffff; color: #212529; }
        .champ-saisie:focus { border-color: var(--jula-blue); outline: none; }
        
        .grille-double { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
        
        /* Zone de capture photo optimisée pour mobile */
        .zone-photo { border: 2px dashed var(--jula-blue); padding: 20px; border-radius: 8px; text-align: center; background: rgba(16, 114, 186, 0.02); cursor: pointer; position: relative; transition: 0.2s; }
        .zone-photo:hover { background: rgba(16, 114, 186, 0.05); }
        .zone-photo i { font-size: 32px; color: var(--jula-blue); margin-bottom: 8px; }
        .zone-photo p { margin: 0; font-size: 13.5px; color: #6c757d; }
        .fichier-cache { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }

        .bouton-publier { width: 100%; background-color: var(--jula-orange); color: white; border: none; padding: 14px; border-radius: 6px; font-size: 16px; font-weight: bold; cursor: pointer; box-shadow: 0 4px 12px rgba(245,124,0,0.25); transition: 0.2s; margin-top: 10px; }
        .bouton-publier:hover { transform: translateY(-1px); opacity: 0.95; }
        
        /* Indicateur de calcul en temps réel du pourcentage */
        .badge-aperçu-reduction { display: inline-block; background-color: rgba(245,124,0,0.1); color: var(--jula-orange); padding: 6px 12px; border-radius: 6px; font-size: 13px; font-weight: bold; margin-top: 8px; display: none; }
    </style>
</head>
<body>

    <div class="barre-superieure">
        <div class="titre-barre"><i class="fa-solid fa-store"></i> Réseau Jula — Espace Grossiste</div>
        <a href="/login" class="bouton-deconnexion"><i class="fa-solid fa-right-from-bracket"></i> Quitter</a>
    </div>

    <div class="conteneur">
        <div class="carte-formulaire">
            <h2><i class="fa-solid fa-plus-circle" style="color: var(--jula-orange);"></i> Ajouter un nouvel article au rayon</h2>
            
            <!-- Formulaire connecté en direct à notre route d'upload du server.js -->
            <form id="formulairePublication" enctype="multipart/form-data">
                <!-- Identifiant caché pour lier le vendeur -->
                <input type="hidden" name="userId" value="<%= userId %>">

                <div class="groupe-champ">
                    <label for="title">Titre du produit ou Modèle de smartphone</label>
                    <input type="text" id="title" name="title" class="champ-saisie" placeholder="Exemple : Tecno Pop 9 Pro 128Go" required>
                </div>

                <div class="groupe-champ">
                    <label for="category">Catégorie du rayon</label>
                    <select id="category" name="category" class="champ-saisie" required>
                        <option value="📱 Écrans Connectés">📱 Écrans Connectés</option>
                        <option value="🔥 Offres Phares Jula">🔥 Offres Phares Jula</option>
                        <option value="💻 Parcs Informatiques">💻 Parcs Informatiques</option>
                    </select>
                </div>

                <div class="grille-double">
                    <div class="groupe-champ">
                        <label for="price">Prix d'origine (FCFA)</label>
                        <input type="number" id="price" name="price" class="champ-saisie" placeholder="Ex : 100000" oninput="calculerPourcentageRemise()" required>
                    </div>
                    <div class="groupe-champ">
                        <label for="promo_price">Prix promotionnel (Optionnel - FCFA)</label>
                        <input type="number" id="promo_price" name="promo_price" class="champ-saisie" placeholder="Ex : 80000" oninput="calculerPourcentageRemise()">
                        <div id="apercuReduction" class="badge-aperçu-reduction"></div>
                    </div>
                </div>
                <div class="grille-double">
                    <div class="groupe-champ">
                        <label for="stock">Quantité disponible en stock</label>
                        <input type="number" id="stock" name="stock" class="champ-saisie" value="1" min="1" required>
                    </div>
                    <div class="groupe-champ">
                        <label>Photo officielle de l'article</label>
                        <div class="zone-photo">
                            <i class="fa-solid fa-camera"></i>
                            <p id="textePhoto">Cliquez pour prendre une photo ou ouvrir votre galerie</p>
                            <!-- L'attribut accept="image/*" force l'ouverture de l'appareil photo sur le Tecno Pop 9 -->
                            <input type="file" id="photoFichier" name="image" class="fichier-cache" accept="image/*" onchange="validerFichierPhoto()" required>
                        </div>
                    </div>
                </div>

                <div class="groupe-champ">
                    <label for="description">Fiche technique ou détails du produit</label>
                    <textarea id="description" name="description" class="champ-saisie" rows="4" placeholder="Ex : État neuf, scellé dans le carton, garantie de 12 mois officielle..." required></textarea>
                </div>

                <button type="submit" class="bouton-publier" id="btnValider">
                    <i class="fa-solid fa-cloud-arrow-up"></i> Valider et mettre en rayon sur Jula
                </button>
            </form>
        </div>
    </div>

    <!-- ⚙️ ROBOT DE LOGIQUE COMMERCIALE EN TEMPS RÉEL (FRANÇAIS UEMOA) -->
    <script>
        // 1. CALCUL AUTOMATIQUE ET INSTANTANÉ DU POURCENTAGE DE RÉDUCTION
        function calculerPourcentageRemise() {
            const prixOrigine = parseFloat(document.getElementById('price').value) || 0;
            const prixPromo = parseFloat(document.getElementById('promo_price').value) || 0;
            const badgeApercu = document.getElementById('apercuReduction');

            if (prixOrigine > 0 && prixPromo > 0 && prixPromo < prixOrigine) {
                // Formule de soustraction et division mathématique identique à l'application mobile
                const calculRemise = Math.round(((prixOrigine - prixPromo) / prixOrigine) * 100);
                
                badgeApercu.style.display = 'inline-block';
                badgeApercu.innerHTML = `<i class="fa-solid fa-tags"></i> Badge créé automatiquement : -${calculRemise}% de réduction`;
            } else {
                badgeApercu.style.display = 'none';
            }
        }

        // 2. MODIFICATION DU TEXTE DÈS QUE LA PHOTO EST PREMIÈREMENT CHOISIE
        function validerFichierPhoto() {
            const selecteur = document.getElementById('photoFichier');
            const texteVisuel = document.getElementById('textePhoto');
            
            if (selecteur.files && selecteur.files[0]) {
                texteVisuel.style.color = '#2e7d32';
                texteVisuel.innerHTML = `<i class="fa-solid fa-circle-check" style="color: #2e7d32; font-size: 16px;"></i> Image sélectionnée : ${selecteur.files[0].name}`;
            }
        }

        // 3. EXPÉDITION SÉCURISÉE EN AJAX VERS LE SERVEUR RENDER SANS RAFRAÎCHIR LA PAGE
        document.getElementById('formulairePublication').addEventListener('submit', async function(evenement) {
            evenement.preventDefault();
            
            const btn = document.getElementById('btnValider');
            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Traitement et envoi vers Supabase Storage en cours...`;

            try {
                const donneesFormulaire = new FormData(this);
                
                // Envoi vers la route de publication du server.js
                const reponse = await fetch('/publish-product', {
                    method: 'POST',
                    body: donneesFormulaire
                });

                const resultat = await reponse.json();

                if (resultat.success) {
                    alert(`✅ Félicitations ! Votre article a été mis en rayon avec succès. Les pourcentages s'affichent en direct sur l'application mobile !`);
                    window.location.href = resultat.redirect_url;
                } else {
                    alert(`❌ Échec de la mise en rayon : ${resultat.error}`);
                    btn.disabled = false;
                    btn.innerHTML = `<i class="fa-solid fa-cloud-arrow-up"></i> Valider et mettre en rayon sur Jula`;
                }
            } catch (erreur) {
                alert(`❌ Erreur réseau : Impossible de joindre l'infrastructure Jula. Réessayez.`);
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-cloud-arrow-up"></i> Valider et mettre en rayon sur Jula`;
            }
        });
    </script>
</body>
</html>
             
